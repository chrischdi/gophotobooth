FROM golang:1.26.1 AS builder
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,id=gophotobooth-gomod,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,id=gophotobooth-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=gophotobooth-gobuild,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o /core ./cmd/core

FROM gcr.io/distroless/static-debian12
COPY --from=builder /core /core
ENTRYPOINT ["/core"]
