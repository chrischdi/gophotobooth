FROM golang:1.26.1 AS builder
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o /gallery ./cmd/gallery

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips-tools \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /gallery /gallery
ENTRYPOINT ["/gallery"]
